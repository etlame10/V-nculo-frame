# Copia este archivo como .env y rellena los valores reales SOLO en el dispositivo.
# Nunca subas .env a GitHub. Todos los valores de este ejemplo son ficticios.

# --- Local (Raspberry Pi) ---
# Carpeta donde se guardan fotografías y la base de datos SQLite local.
VINCULO_DATA_DIR=./data
# Segundos que cada fotografía permanece en pantalla.
VINCULO_SLIDE_SECONDS=15
# Segundos que hay que mantener pulsado el botón SOS para activarlo (2-3 s recomendado).
VINCULO_SOS_HOLD_SECONDS=2.5
# Tamaño máximo aceptado por fotografía, en megabytes.
VINCULO_MAX_PHOTO_MB=10
# Nivel de registro: DEBUG, INFO, WARNING, ERROR.
VINCULO_LOG_LEVEL=INFO

# --- Telegram (fase 5; no se usa todavía) ---
TELEGRAM_BOT_TOKEN=000000000:REEMPLAZAR-POR-TOKEN-FICTICIO

# --- Supabase (fase 4; no se usa todavía) ---
SUPABASE_URL=https://example-project.supabase.co
# Clave pública (anon/publishable). Por sí sola solo permite lo que autorice RLS.
SUPABASE_ANON_KEY=reemplazar-por-clave-publica-ficticia
# Usuario propio del marco en Supabase Auth (limitado por RLS a este marco).
# La clave service_role NUNCA debe estar en la Raspberry Pi ni en el navegador.
SUPABASE_DEVICE_EMAIL=marco-ejemplo@example.invalid
SUPABASE_DEVICE_PASSWORD=reemplazar-por-contrasena-ficticia
# Identificador del marco en la base de datos compartida.
VINCULO_DEVICE_ID=00000000-0000-0000-0000-000000000000
