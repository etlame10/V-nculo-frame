# Secretos de las Edge Functions. Valores FICTICIOS: los reales se configuran
# con `supabase secrets set` en el proyecto (nunca en este repositorio).
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los pone Supabase automáticamente.

# Token del bot (BotFather). Quien lo tenga puede leer y enviar como el bot.
TELEGRAM_BOT_TOKEN=000000000:REEMPLAZAR-POR-TOKEN-FICTICIO
# Secreto que Telegram envía en cada llamada al webhook (setWebhook secret_token).
# 1-256 caracteres A-Z, a-z, 0-9, _ y -. Generar uno largo y aleatorio.
TELEGRAM_WEBHOOK_SECRET=reemplazar-por-secreto-largo-y-aleatorio
